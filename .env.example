# Frontend API Base URL (Optional if deployed full-stack on Vercel/Cloud Run; set to your deployed backend URL if frontend and backend are hosted separately)
# Example: VITE_API_URL="https://YOUR-BACKEND-DOMAIN"
VITE_API_URL=""

# Allowed Frontend Origins for CORS (Comma-separated list of allowed frontend domains)
# Example: CORS_ORIGIN="https://your-project.vercel.app"
CORS_ORIGIN=""
FRONTEND_URL=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# MongoDB connection URI (Production MongoDB Atlas connection string)
# Example: MONGODB_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/nova_mobile?retryWrites=true&w=majority"
MONGODB_URI=""

# JWT secret key for customer & admin authentication
JWT_SECRET=""

# Admin account credentials (verified strictly on the backend; never exposed to frontend)
ADMIN_EMAIL="admin@novamobile.com"
ADMIN_PASSWORD=""
ADMIN_PASSWORD_HASH=""

# GEMINI_API_KEY: Optional for AI features
GEMINI_API_KEY=""
